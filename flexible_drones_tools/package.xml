<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flexible_drones_tools</name>
  <version>0.0.1</version>
  <description>Command-line clients, action servers, demos, and monitoring tools for Flexible Drones.</description>

  <author>Emma Faith</author>
  <author>Andrew Farney</author>
  <author>Sebastian Fox</author>
  <author>Evangelina Grimes</author>
  <author>Aubrie Kooiker</author>
  <maintainer email="robotics@cnu.edu">David Conner</maintainer>
  <url type="website">https://github.com/CNURobotics/flexible_drones</url>
  <url type="bugtracker">https://github.com/CNURobotics/flexible_drones/issues</url>
  <url type="repository">https://github.com/CNURobotics/flexible_drones</url>


  <license>Apache-2.0</license>

  <depend>flexible_drones_core</depend>
  <depend>flexible_drones_msgs</depend>
  <depend>action_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>builtin_interfaces</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>nav_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>rclpy</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>urdfdom_py</exec_depend>
  <exec_depend>tf_transformations</exec_depend>

  <!-- casadi (trajectory planner) and matplotlib (plotting tools) are
       installed with pip via requirements.txt; they are intentionally not
       declared for rosdep because lab machines install them into a
       workspace virtual environment. See README.md. -->

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
