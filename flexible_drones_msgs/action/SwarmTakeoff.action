# Swarm-wide takeoff: dispatches to all commandable drones in parallel.
float32 height        # target height in metres
builtin_interfaces/Duration duration  # transition time; 0 means use provider default
---
int32 targeted              # drones selected for this command
int32 unavailable           # drones skipped because their action server was unreachable
int32 sent                  # goals sent to a reachable action server
int32 accepted              # goals accepted by the action server
int32 rejected              # goals rejected by the action server
int32 goal_response_timeout # goals that got no response before the configured timeout
int32 succeeded             # accepted goals that finished with return_code 0
int32 failed                # accepted goals that finished with nonzero return_code or exception
int32 canceled              # accepted goals that were canceled
int32 result_timeout        # accepted goals that produced no result before the configured timeout
int32 return_code           # 0 all succeeded, 1 partial, 2 none succeeded, 4 another swarm action is active, 5 canceled
---
int32 targeted
int32 unavailable
int32 sent
int32 accepted
int32 rejected
int32 goal_response_timeout
int32 succeeded
int32 failed
int32 canceled
int32 result_timeout
