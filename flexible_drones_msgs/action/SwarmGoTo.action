# Swarm-wide relative goto: each drone moves by (x, y, z, yaw) from its current position.
#
# Absolute swarm goto is intentionally unsupported — a single target position cannot
# be meaningfully shared across multiple drones.  FRAME_ABSOLUTE goals are rejected.
uint8 FRAME_RELATIVE_MAP  = 1  # offset added in ENU/map frame
uint8 FRAME_RELATIVE_BODY = 2  # offset in body frame: x=forward along heading, y=left
float32 x           # offset in metres
float32 y           # offset in metres
float32 z           # offset in metres
float32 yaw         # offset in radians
builtin_interfaces/Duration duration  # transition time; 0 means use provider default
uint8 frame         # FRAME_RELATIVE_MAP or FRAME_RELATIVE_BODY; FRAME_ABSOLUTE (0) rejected
---
int32 targeted              # drones selected for this command
int32 unavailable           # drones skipped because their action server was unreachable
int32 sent                  # goals sent to a reachable action server
int32 accepted              # goals accepted by the action server
int32 rejected              # goals rejected by the action server
int32 goal_response_timeout # goals that got no response before the configured timeout
int32 succeeded             # accepted goals that finished with return_code 0
int32 failed                # accepted goals that finished with nonzero return_code or exception
int32 canceled              # accepted goals that were canceled
int32 result_timeout        # accepted goals that produced no result before the configured timeout
int32 return_code           # 0 all succeeded, 1 partial, 2 none succeeded, 3 invalid request, 4 another swarm action is active, 5 canceled
---
int32 targeted
int32 unavailable
int32 sent
int32 accepted
int32 rejected
int32 goal_response_timeout
int32 succeeded
int32 failed
int32 canceled
int32 result_timeout
