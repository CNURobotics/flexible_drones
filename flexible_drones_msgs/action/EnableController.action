# Generic session-style controller gate. Dedicated controller topics may leave
# controller_name empty to imply the topic's controller instance name.
string controller_name
string params_yaml
---
int32 return_code
string message
string active_controller
---
string controller_name
float32 input_age_sec
bool controller_active
string status_text
string status_yaml
