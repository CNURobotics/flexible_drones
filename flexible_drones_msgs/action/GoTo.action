uint8 FRAME_ABSOLUTE      = 0  # absolute ENU target position
uint8 FRAME_RELATIVE_MAP  = 1  # offset added in ENU/map frame
uint8 FRAME_RELATIVE_BODY = 2  # offset in body frame: x=forward along heading, y=left
uint8 group_mask  # goal accepted when 0 or overlapping the drone's configured group mask
uint8 frame
geometry_msgs/Point goal
float32 yaw # rad
builtin_interfaces/Duration duration  # direct per-drone action duration; must be positive
---
int32 return_code
---
geometry_msgs/Point current_position
float32 current_yaw # rad
