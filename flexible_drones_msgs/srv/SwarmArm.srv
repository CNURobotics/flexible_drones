---
bool success
string message
int32 targeted        # drones selected for this command
int32 unavailable     # drones skipped because their service was unreachable
int32 sent            # service calls sent to a reachable server
int32 succeeded       # calls that returned success
int32 failed          # calls that returned failure or raised an exception
int32 response_timeout  # calls that produced no response before the configured timeout
