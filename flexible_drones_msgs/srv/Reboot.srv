# Request a safe vehicle flight-controller/firmware reboot.
#
# Implementations must reject this request unless the vehicle is disarmed and
# confirmed on the ground. Platform-specific managers/nodes should restart their
# connection, estimator/time-sync setup, and status publication after reboot.

float32 timeout_sec  # seconds to wait for reboot/drop confirmation when supported
---
bool success
string message
