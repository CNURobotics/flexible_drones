<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>flexible_drones_msgs</name>
  <version>0.0.1</version>
  <description>ROS 2 interfaces for the Flexible Drones stack.</description>

  <author>Emma Faith</author>
  <author>Andrew Farney</author>
  <author>Sebastian Fox</author>
  <author>Evangelina Grimes</author>
  <author>Aubrie Kooiker</author>
  <maintainer email="robotics@cnu.edu">David Conner</maintainer>
  <url type="website">https://github.com/CNURobotics/flexible_drones</url>
  <url type="bugtracker">https://github.com/CNURobotics/flexible_drones/issues</url>
  <url type="repository">https://github.com/CNURobotics/flexible_drones</url>


  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>action_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <test_depend>ament_cmake_copyright</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
